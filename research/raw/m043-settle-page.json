      "file": "tmp/m043-settle-lazy.probe.js",
      "note": "run-code file: \"async page => {...}\", run in a new tab that is closed afterwards. It adds an init script before any page script runs, which records every angular-ai:record the page agent dispatches and takes one second subscription on the same ApplicationRef.isStable the shipped read subscribes to. The page then loads the route itself.",
      "source": "async page => {\n  const base = 'http://localhost:4222';\n  const route = '/lazy';\n\n  await page.addInitScript(() => {\n    window.__m043 = { records: [], stream: [], observer: null, observerError: null };\n\n    window.addEventListener('angular-ai:record', (e) => {\n      const d = e.detail || {};\n      window.__m043.records.push({\n        at: performance.now(),\n        path: location.pathname,\n        cycleId: d.cycleId ?? null,\n        startedAt: d.startedAt ?? null,\n        trigger: d.trigger ?? null,\n        zoneMode: d.zoneMode ?? null,\n        events: (d.events || []).length,\n        routerEvents: (d.routerEvents || []).slice(),\n        stability: d.stability ?? null,\n        checks: (d.checks || []).map((c) => c.componentName ?? null),\n      });\n    });\n\n    const subscribeWhenAvailable = () => {\n      try {\n        const ng = window.ng;\n        if (!ng || typeof ng.getInjector !== 'function' || typeof ng.ɵgetInjectorResolutionPath !== 'function') return false;\n        const host = document.querySelector('app-root');\n        if (!host) return false;\n        const injector = ng.getInjector(host);\n        if (!injector) return false;\n        const path = ng.ɵgetInjectorResolutionPath(injector) || [injector];\n        for (const entry of path) {\n          const records = ng.ɵgetInjectorProviders(entry);\n          for (const record of records || []) {\n            if (record && record.token && record.token.name === 'ApplicationRef') {\n              window.__m043.observer = 'ApplicationRef';\n              window.__m043.observerAt = performance.now();\n              entry.get(record.token).isStable.subscribe((value) => {\n                window.__m043.stream.push({ value: value === true, at: performance.now(), path: location.pathname });\n              });\n              return true;\n            }\n          }\n        }\n      } catch (e) {\n        window.__m043.observerError = String((e && e.message) || e);\n      }\n      return false;\n    };\n    let tries = 0;\n    const timer = setInterval(() => {\n      tries += 1;\n      if (subscribeWhenAvailable() || tries > 4000) clearInterval(timer);\n    }, 5);\n  });\n\n  await page.goto(base + route);\n\n  await page.waitForFunction(\n    () => window.__m043 && window.__m043.records.some((r) => r.stability && r.stability.attachAt !== null),\n    null,\n    { timeout: 30000 },\n  );\n\n  // The drive waits for the page's own settle, then for the page to go quiet.\n  let settledInPage = true;\n  try {\n    await page.waitForFunction(\n      () => window.__m043.records.some((r) => r.stability && r.stability.settle && r.stability.settle.state === 'settled'),\n      null,\n      { timeout: 30000 },\n    );\n  } catch (e) {\n    settledInPage = false;\n  }\n\n  await page.waitForFunction(\n    () => {\n      const r = window.__m043.records;\n      const last = r.length ? r[r.length - 1].at : 0;\n      return performance.now() - last > 600;\n    },\n    null,\n    { timeout: 30000 },\n  );\n\n  const t = await page.evaluate(() => {\n    const timing = performance.timing || {};\n    return {\n      url: location.href,\n      path: location.pathname,\n      title: document.title,\n      ngVersion: document.querySelector('[ng-version]')?.getAttribute('ng-version') ?? null,\n      readyState: document.readyState,\n      navigationStart: timing.navigationStart ?? null,\n      domContentLoadedEventEnd: timing.domContentLoadedEventEnd ?? null,\n      loadEventEnd: timing.loadEventEnd ?? null,\n      observedAt: performance.now(),\n      observer: window.__m043.observer,\n      observerAt: window.__m043.observerAt ?? null,\n      observerError: window.__m043.observerError,\n      records: window.__m043.records,\n      stream: window.__m043.stream,\n      bodyPrefix: document.body ? document.body.textContent.trim().slice(0, 160) : null,\n      routeViewTag: document.querySelector('router-outlet')?.nextElementSibling?.tagName ?? null,\n    };\n  });\n\n  return { route, settledInPage, ...t };\n}"
    },
