        "gpu": [],
        "cpu": null
      },
      "model": {
        "name": "Phi-4-mini-instruct",
        "folders": "EdgeLLMOnDeviceModel\\<version>",
        "asset": "^edge_base_model$",
        "useCase": "prompt_api",
        "contextWindow": 9216,
