{
  "name": "angular-ai-devtools-workspace",
  "private": true,
  "type": "module",
  "description": "Sandbox scripts that install agent skills and subagents for the AI coding CLIs.",
  "scripts": {
    "check": "node scripts/ensure-sidecar-deps.mjs && tsc -p tsconfig.json && npm run check:skills && npm run check:panel && npm run check:companion",
    "check:skills": "tsc -p .claude/skills/tsconfig.json && tsc -p .claude/skills/tsconfig.run-code.json && tsc -p .commandcode/skills/tsconfig.json && tsc -p .commandcode/skills/tsconfig.run-code.json",
    "check:panel": "tsc -p apps/angular-ai-devtools/tsconfig.check.json",
    "check:companion": "tsc -p packages/ai-devtools-companion/tsconfig.json",
    "test": "node --experimental-strip-types --test \"scripts/**/*.test.mjs\" \"extension/**/*.test.mjs\" && node scripts/run-user-scope-tests.mjs && npm run test:skills && npm run test:app",
    "test:skills": "node --experimental-strip-types --test \".claude/skills/**/*.test.mjs\" \".commandcode/skills/**/*.test.mjs\"",
    "test:app": "npx nx run angular-ai-devtools:test"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@nx/angular": "^23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/web": "23.3.0",
    "@opencode/plugin": "2.0.29",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^26.6.5",
    "jsdom": "^27.1.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  }
}
