{
  "name": "angular-ai-devtools",
  "private": true,
  "type": "module",
  "description": "Sandbox scripts that install agent skills and subagents for the AI coding CLIs.",
  "scripts": {
    "check": "tsc -p tsconfig.json && npm run check:skills",
    "check:skills": "tsc -p .claude/skills/tsconfig.json && tsc -p .claude/skills/tsconfig.run-code.json",
    "test": "node --test \"scripts/**/*.test.mjs\" && npm run test:skills",
    "test:skills": "node --test \".claude/skills/**/*.test.mjs\""
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29",
    "@types/node": "^26.6.5",
    "typescript": "6.0.3"
  }
}
