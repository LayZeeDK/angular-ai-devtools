{
  // Type-check the pstack opencode installer, its tests, and the plugin template
  // it ships. The other install-*.mjs scripts in scripts/ are plain unannotated
  // JavaScript.
  "include": [
    "C:/Users/LarsGyrupBrinkNielse/.commandcode/scripts/install-pstack-opencode.mjs",
    "C:/Users/LarsGyrupBrinkNielse/.commandcode/scripts/install-pstack-opencode.test.mjs",
    "scripts/opencode-pstack-plugin.ts"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
