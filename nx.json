{
  "analytics": false,
  "namedInputs": {
    "extensionArtifacts": [
      "{workspaceRoot}/extension/panel/**",
      "{workspaceRoot}/packages/ai-devtools-companion/dist/**"
    ],
    "projectBookkeeping": [
      "{workspaceRoot}/.project/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ]
    },
    "@angular/build:unit-test": {
      "cache": false,
      "inputs": [
        "default",
        "^default",
        "extensionArtifacts",
        "projectBookkeeping"
      ]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ],
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "style": "css",
      "unitTestRunner": "vitest-angular"
    }
  }
}
