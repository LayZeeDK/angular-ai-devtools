{
  "name": "ai-devtools-companion",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/ai-devtools-companion",
  "projectType": "library",
  "sourceRoot": "packages/ai-devtools-companion/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "tsc -p packages/ai-devtools-companion/tsconfig.json --noEmit false --outDir packages/ai-devtools-companion/dist --declaration --declarationMap --sourceMap",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
