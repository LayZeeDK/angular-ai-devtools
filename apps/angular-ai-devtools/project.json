{
  "name": "angular-ai-devtools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/angular-ai-devtools/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/angular-ai-devtools",
        "browser": "apps/angular-ai-devtools/src/main.ts",
        "tsConfig": "apps/angular-ai-devtools/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular-ai-devtools/public"
          }
        ],
        "styles": [
          "apps/angular-ai-devtools/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "build-extension": {
      "executor": "@angular/build:application",
      "cache": false,
      "dependsOn": [
        "generate-error-digest"
      ],
      "outputs": [
        "{workspaceRoot}/extension/panel"
      ],
      "options": {
        "outputPath": {
          "base": "extension/panel",
          "browser": ""
        },
        "browser": "apps/angular-ai-devtools/src/main.ts",
        "tsConfig": "apps/angular-ai-devtools/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular-ai-devtools/public"
          }
        ],
        "styles": [
          "apps/angular-ai-devtools/src/styles.css"
        ],
        "baseHref": "/panel/",
        "outputHashing": "none",
        "extractLicenses": false,
        "optimization": {
          "scripts": true,
          "styles": {
            "minify": true,
            "inlineCritical": false
          },
          "fonts": true
        },
        "budgets": [
          {
            "type": "initial",
            "maximumWarning": "520kb",
            "maximumError": "1mb"
          },
          {
            "type": "anyComponentStyle",
            "maximumWarning": "4kb",
            "maximumError": "8kb"
          }
        ]
      }
    },
    "generate-error-digest": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/extension/error-digest.json"
      ],
      "options": {
        "command": "node scripts/generate-error-digest.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "angular-ai-devtools:build:production"
        },
        "development": {
          "buildTarget": "angular-ai-devtools:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "cache": false,
      "options": {
        "watch": false,
        "include": [
          "**/*.spec.ts"
        ],
        "exclude": [
          "**/*.node.test.ts"
        ]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-ai-devtools:build",
        "port": 4200,
        "staticFilePath": "dist/apps/angular-ai-devtools/browser",
        "spa": true
      }
    }
  }
}
